   "source": [
    "#sigmoid Function\n",
    "import math\n",
    "def sigmoid(x):\n",
    "    return 1 / (1 + math.exp(-x))\n",
    "\n",
    "x = int(input(\"your number >>\"))\n",
    "result = sigmoid(x)\n",
    "\n",
    "print(\"The sigmoid function of \", x, \"is\", result )"
   ]
